---
import '../styles/global.css';
import { siteConfig } from '../config/site';

interface Props {
  lang?: 'fr' | 'en';
  title?: string;
  description?: string;
  keywords?: string;
  faqs?: Array<{ q: string; a: string }>;
}

const {
  lang = 'fr',
  title = `${siteConfig.name} — ${siteConfig.legalName} | Du champ à votre cuisine`,
  description = "Approvisionnement en vivres frais et produits agricoles du terroir à Yaoundé. SRE accompagne ménages, restaurants et partenaires dans la recherche et la livraison de denrées de qualité selon leur budget.",
  keywords = "approvisionnement vivrier Yaoundé, vivres frais Cameroun, fruits et légumes Yaoundé, livraison courses Nkomkana, marché vivrier Cameroun, produits agricoles du terroir, SOUL REGAL SANS ÉGAL, SRE, panier ménage Yaoundé",
  faqs = [],
} = Astro.props;

const siteUrl = siteConfig.website || 'https://sre.cm';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const frUrl = new URL('/', siteUrl).toString();
const enUrl = new URL('/en/', siteUrl).toString();
const ogImageUrl = new URL('/images/hero-produce.jpg', siteUrl).toString();
const ogLocale = lang === 'en' ? 'en_CM' : 'fr_CM';
const schemaLang = lang === 'en' ? 'en-CM' : 'fr-CM';

const schemas: any[] = [
  {
    '@type': 'LocalBusiness',
    '@id': `${siteUrl}/#business`,
    name: siteConfig.legalName,
    alternateName: siteConfig.name,
    legalName: siteConfig.legalName,
    url: siteUrl,
    logo: new URL('/favicon.svg', siteUrl).toString(),
    image: ogImageUrl,
    description,
    slogan: siteConfig.fullTagline,
    telephone: siteConfig.phones,
    email: siteConfig.email,
    taxID: siteConfig.niu,
    identifier: siteConfig.rccm,
    priceRange: lang === 'en' ? 'Adapted to customer budget' : 'Adapté selon le budget du client',
    currenciesAccepted: 'XAF',
    paymentAccepted: 'Espèces, Paiement Mobile (Orange Money, MTN MoMo), Virement',
    address: {
      '@type': 'PostalAddress',
      streetAddress: siteConfig.district,
      addressLocality: siteConfig.city,
      addressRegion: 'Centre',
      addressCountry: siteConfig.countryCode,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: '3.8763',
      longitude: '11.5174',
    },
    areaServed: [
      { '@type': 'City', name: 'Yaoundé' },
      { '@type': 'AdministrativeArea', name: 'Région du Centre' },
      { '@type': 'Country', name: 'Cameroun' },
    ],
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
        opens: '07:00',
        closes: '19:00',
      },
    ],
  },
  {
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    url: siteUrl,
    name: `${siteConfig.name} — ${siteConfig.legalName}`,
    description,
    publisher: { '@id': `${siteUrl}/#business` },
    inLanguage: schemaLang,
  },
];

if (faqs.length > 0) {
  schemas.push({
    '@type': 'FAQPage',
    '@id': `${siteUrl}/#faq`,
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  });
}

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': schemas,
};
---
<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#17392f" />
    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={siteConfig.legalName} />
    <meta name="publisher" content={siteConfig.legalName} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Géolocalisation SEO pour Yaoundé, Cameroun -->
    <meta name="geo.region" content="CM-CE" />
    <meta name="geo.placename" content="Yaoundé" />
    <meta name="geo.position" content="3.8763;11.5174" />
    <meta name="ICBM" content="3.8763, 11.5174" />

    <!-- Balise Canonique et Balises d'internationalisation Hreflang -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={frUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Préchargement des polices typographiques -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <!-- Protocole Open Graph (Facebook, WhatsApp, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={siteConfig.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content="Sélection de vivres frais et produits agricoles du terroir par SRE à Yaoundé" />

    <!-- Cartes Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Données structurées enrichies Schema.org (LocalBusiness, WebSite, FAQPage) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <slot name="head" />
  </head>
  <body>
    <slot />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
