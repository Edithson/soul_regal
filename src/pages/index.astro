---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const hasSocial = Boolean(siteConfig.social.facebook || siteConfig.social.instagram || siteConfig.social.linkedin);

const services = [
  {
    number: '01',
    icon: 'basket',
    title: 'Pour les ménages & familles',
    description: 'Retrouvez le plaisir des repas faits maison sans la fatigue des marchés bondés. Nous sélectionnons pour vous les meilleurs vivres frais — légumes feuilles, tubercules, fruits mûris au soleil et épices du pays — selon vos préférences familiales et votre budget.',
    points: ['Listes de courses sur-mesure pour votre foyer', 'Sélection minutieuse des calibres et de la fraîcheur', 'Livraison douce et soignée devant votre porte'],
    link: 'Composer mon panier familial',
    href: '#contact',
    tone: 'sage',
  },
  {
    number: '02',
    icon: 'store',
    title: 'Pour les restaurants & traiteurs',
    description: 'La qualité constante de vos assiettes repose sur la noblesse de vos ingrédients. Nous approvisionnons vos fourneaux en denrées vivrières saines, triées avec rigueur et livrées selon vos horaires de service et vos volumes d’activité.',
    points: ['Approvisionnements ponctuels ou réguliers', 'Calibres homogènes et régularité des arrivages', 'Clarté de la facturation et ponctualité logistique'],
    link: 'Organiser nos approvisionnements',
    href: '#contact',
    tone: 'cream',
  },
  {
    number: '03',
    icon: 'globe',
    title: 'Pour les ONG & partenaires',
    description: 'Un relais de confiance ancré sur le terrain pour mobiliser les producteurs locaux, consolider d’importants volumes de denrées et préparer vos commandes dans le cadre de programmes d’assistance, d’alimentation ou d’opérations logistiques.',
    points: ['Sourcing direct auprès des filières agricoles locales', 'Tri, pesée et conditionnement adaptés au cahier des charges', 'Coordination logistique transparente et responsable'],
    link: 'Échanger sur un partenariat de terrain',
    href: '#partenaires',
    tone: 'sand',
  },
];

const steps = [
  {
    n: '01',
    title: 'L’écoute attentive',
    text: 'Vous nous partagez vos habitudes culinaires, les denrées souhaitées, les quantités et l’enveloppe budgétaire dans laquelle vous désirez vous inscrire.',
  },
  {
    n: '02',
    title: 'La quête matinale',
    text: 'Dès les premières heures du jour, nous sélectionnons les récoltes les plus vives auprès de nos producteurs et circuits partenaires de confiance.',
  },
  {
    n: '03',
    title: 'Le soin du tri',
    text: 'Chaque tubercule, fruit ou botte de légumes est inspecté, préparé avec délicatesse et emballé pour préserver toute sa vitalité nourricière.',
  },
  {
    n: '04',
    title: 'L’arrivée en cuisine',
    text: 'Vos vivres vous sont remis à Yaoundé dans le créneau convenu, prêts à embaumer vos marmites et réjouir vos tablées.',
  },
];

const faqs = [
  {
    q: 'Dans quels quartiers de Yaoundé assurez-vous la livraison des vivres frais ?',
    a: 'Notre siège d’activité est établi à Nkomkana. Nous livrons sur l’ensemble des quartiers de Yaoundé (Nkomkana, Bastos, Biyem-Assi, Omnisports, Mendong, Odza, Simbock, Mvan, Dragages, Mermoz, etc.). Chaque tournée est planifiée avec soin pour préserver la fraîcheur de vos produits entre le marché et votre cuisine.',
  },
  {
    q: 'Puis-je commander des produits spécifiques ou des épices traditionnelles du Cameroun ?',
    a: 'Absolument. Qu’il s’agisse de légumes verts traditionnels (ndolè, folon, zom), de tubercules choisis (plantains mûrs ou d’un vert franc, macabos tendres, manioc doux), de fruits de saison ou d’épices emblématiques de nos terroirs (djansang, pèbè, rondelles, poivre blanc de Penja), nous composons votre commande selon votre demande exacte.',
  },
  {
    q: 'Comment SRE adapte-t-elle ses propositions à mon budget ?',
    a: 'La franchise et le respect de votre budget sont au cœur de notre vocation. Avant tout approvisionnement, nous échangeons sur vos priorités et vos moyens. Notre connaissance directe des cours du marché nous permet de vous orienter vers les meilleures denrées de saison, sans dépenses superflues.',
  },
  {
    q: 'Comment passer commande et quel délai est nécessaire ?',
    a: 'Vous pouvez nous joindre par WhatsApp ou appel téléphonique au +237 683 511 935 / +237 694 929 167, ou via le formulaire de contact. Pour vous garantir des vivres sélectionnés à l’aube du jour même, nous vous recommandons de réserver votre commande la veille.',
  },
  {
    q: 'Accompagnez-vous les établissements professionnels et les programmes d’ONG ?',
    a: 'Oui. Pour les restaurateurs, hôtels et cantines, nous étudions des calendriers de livraisons récurrentes avec des critères de calibre bien précis. Pour les organisations humanitaires et acheteurs institutionnels, nous structurons la collecte, le tri et le conditionnement selon les cahiers des charges établis.',
  },
];
---

<BaseLayout faqs={faqs}>
  <div id="top" style="position: absolute; top: 0; left: 0; width: 1px; height: 1px; pointer-events: none;" aria-hidden="true"></div>

  <div class="announcement-bar">
    <div class="container announcement-inner">
      <span class="announcement-dot"></span>
      <span>Vivres frais du terroir camerounais · De la terre à votre cuisine</span>
      <span class="announcement-location">{siteConfig.location}</span>
    </div>
  </div>

  <header class="site-header" id="main-header">
    <div class="container nav-wrap">
      <a class="brand" href="#top" aria-label="SRE — Accueil">
        <span class="brand-mark"><span>S</span><span>R</span><span>E</span></span>
        <span class="brand-copy"><strong>{siteConfig.name}</strong><small>{siteConfig.legalName}</small></span>
      </a>
      <button class="menu-toggle" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="main-nav">
        <span></span><span></span>
      </button>
      <nav class="main-nav" id="main-nav" aria-label="Navigation principale">
        <a href="#maison">L’esprit SRE</a>
        <a href="#solutions">Nos formules</a>
        <a href="#methode">Notre savoir-faire</a>
        <a href="#partenaires">Partenaires & Terroir</a>
        <a class="nav-cta" href="#contact">Échanger sur vos besoins</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero section-shell">
      <div class="hero-glow"></div>
      <div class="container hero-grid">
        <div class="hero-copy" data-reveal>
          <div class="eyebrow"><span class="eyebrow-line"></span> SOUL REGAL SANS ÉGAL · YAOUNDÉ</div>
          <h1>Les trésors de notre terroir,<br /><em>directement dans</em><br /><em>votre cuisine.</em></h1>
          <p class="hero-lead">Bien manger commence par la confiance dans ce que la terre offre de plus pur. À Yaoundé, SRE sélectionne pour vous des vivres frais, légumes, tubercules et épices locales, et prend soin de votre approvisionnement selon votre budget.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#solutions">Découvrir nos formules</a>
            <a class="text-link" href="#maison">Comprendre notre histoire</a>
          </div>
          <div class="hero-proof">
            <div class="proof-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.5 3.5C10 3.5 4 7.3 4 14.2c0 3.2 2.3 5.3 5.4 5.3 7.2 0 11.1-7.2 11.1-16Z" />
                <path d="M3.5 21c2.6-5.2 6.3-8.6 11.2-10.7" />
              </svg>
            </div>
            <p><strong>L’exigence du frais au quotidien.</strong><span>Des récoltes choisies avec patience pour nourrir vos familles et sublimer vos tables.</span></p>
          </div>
        </div>

        <div class="hero-visual" data-reveal data-delay="140">
          <div class="hero-image-main">
            <img
              src="/images/hero-produce.jpg"
              width="1600"
              height="1200"
              alt="Sélection de légumes et vivres frais du terroir camerounais sur un étal"
              fetchpriority="high"
            />
          </div>
          <div class="hero-image-stamp">
            <span>SRE</span>
            <strong>DU CHAMP<br />À VOTRE TABLE</strong>
          </div>
          <div class="hero-floating-card">
            <span class="floating-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 7.5h16l-1.4 12H5.4L4 7.5Z" />
                <path d="M8 8V6a4 4 0 0 1 8 0v2" />
                <path d="m9 13 2 2 4-4" />
              </svg>
            </span>
            <span><strong>Sélection attentive</strong><small>Adaptée à votre budget</small></span>
          </div>
          <span class="hero-vertical-note">TERROIR · RIGUEUR · CONFORT</span>
        </div>
      </div>
      <div class="container hero-bottomline">
        <span>L’ALLIANCE DE LA TERRE ET DU FOYER</span>
        <span class="scroll-cue"><span></span> FAITES DÉFILER</span>
        <span>NKOMKANA, YAOUNDÉ</span>
      </div>
    </section>

    <section class="intro-strip" aria-label="Nos principes fondamentaux">
      <div class="container intro-strip-grid">
        <p class="strip-lead">L’authenticité du champ.<br /><em>La paix de l’esprit.</em></p>
        <div class="strip-item"><span class="strip-number">01</span><div><strong>Proximité humaine</strong><small>Valoriser les cultivateurs et circuits locaux.</small></div></div>
        <div class="strip-item"><span class="strip-number">02</span><div><strong>Rigueur du choix</strong><small>Prendre soin de chaque denrée avec minutie.</small></div></div>
        <div class="strip-item"><span class="strip-number">03</span><div><strong>Justesse du prix</strong><small>Vous accompagner en respectant votre budget.</small></div></div>
      </div>
    </section>

    <section class="product-band" aria-label="Denrées vivrières approvisionnées">
      <div class="container product-band-inner">
        <span class="product-band-label">CE QUE LA TERRE NOUS OFFRE AU FIL DES SAISONS</span>
        <div class="product-tags">
          <span>Légumes feuilles & condiments du pays</span>
          <span class="tag-sep" aria-hidden="true">·</span>
          <span>Plantains, macabos & tubercules</span>
          <span class="tag-sep" aria-hidden="true">·</span>
          <span>Fruits gorgés de soleil</span>
          <span class="tag-sep" aria-hidden="true">·</span>
          <span>Céréales & légumineuses</span>
          <span class="tag-sep" aria-hidden="true">·</span>
          <span>Épices & aromates traditionnels</span>
        </div>
      </div>
    </section>

    <section class="section about-section" id="maison">
      <div class="container about-grid">
        <div class="about-visual" data-reveal>
          <div class="about-image-large">
            <img
              src="/images/paysage2.jpg"
              width="720"
              height="900"
              alt="Plantations et campagnes fertiles des environs de Yaoundé au lever du jour"
              loading="lazy"
            />
          </div>
          <div class="about-image-small">
            <img
              src="/images/about-vegetables.jpg"
              width="850"
              height="1285"
              alt="Feuilles vertes et légumes maraîchers fraîchement cueillis"
              loading="lazy"
            />
          </div>
          <div class="about-caption">
            <span>L’ESPRIT DU TERROIR</span>
            <strong>Nourrir la vie,<br />simplement.</strong>
          </div>
        </div>
        <div class="about-copy" data-reveal data-delay="100">
          <div class="eyebrow"><span class="eyebrow-line"></span> AUX RACINES DE SRE</div>
          <h2>Réconcilier l’abondance des champs <em>avec le rythme de votre quotidien.</em></h2>
          <p class="section-lead">Au Cameroun, la terre est généreuse, mais trouver chaque semaine des vivres véritablement frais, sains et au juste prix relève souvent d’une épreuve entre poussière, encombrements et marchandages incertains.</p>
          <p>Implantée à Nkomkana, au cœur de Yaoundé, SOUL REGAL SANS ÉGAL est née de ce désir fraternel : offrir à chaque foyer, chaque cuisinier et chaque établissement la certitude de recevoir le meilleur de nos terroirs sans fatigue ni compromis.</p>
          <p>Nous sillonnons les plantations environnantes et les allées vivrières avec patience. Chaque régime de plantain, chaque botte de feuilles fraîches, chaque sac de tubercules est choisi avec le même regard vigilant qu’une mère de famille attentive. Nous veillons sur vos courses pour que vous puissiez vous consacrer à l’essentiel : le plaisir de cuisiner et de partager.</p>
          <a class="underlined-link" href="#methode">Découvrir notre savoir-faire</a>
          <div class="signature">
            <span class="signature-mark">SRE</span>
            <span><strong>{siteConfig.legalName}</strong><small>{siteConfig.fullTagline}</small></span>
          </div>
        </div>
      </div>
    </section>

    <section class="section solutions-section" id="solutions">
      <div class="container">
        <div class="section-heading section-heading-row" data-reveal>
          <div>
            <div class="eyebrow"><span class="eyebrow-line"></span> NOS FORMULES D’APPROVISIONNEMENT</div>
            <h2>Une attention sur-mesure.<br /><em>Trois manières de vous accompagner.</em></h2>
          </div>
          <p>Que vous cuisiniez pour quelques convives ou pour des centaines de couverts, notre engagement demeure le même : la fraîcheur absolue et le respect scrupuleux de votre budget.</p>
        </div>
        <div class="services-grid">
          {services.map((service) => (
            <article class={`service-card service-${service.tone}`} data-reveal>
              <div class="service-topline">
                <span class="service-icon" aria-hidden="true">
                  {service.icon === 'basket' && (
                    <svg viewBox="0 0 24 24"><path d="m3 9 2 11h14l2-11H3Z"/><path d="M7 9 12 3l5 6M8.5 12l.8 5M15.5 12l-.8 5M12 12v5"/></svg>
                  )}
                  {service.icon === 'store' && (
                    <svg viewBox="0 0 24 24"><path d="M3 10h18l-1.5-6h-15L3 10Z"/><path d="M5 10v10h14V10M9 20v-6h6v6M3 10a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0"/></svg>
                  )}
                  {service.icon === 'globe' && (
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg>
                  )}
                </span>
              </div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <ul>
                {service.points.map((point) => (
                  <li>
                    <span class="point-bullet" aria-hidden="true"></span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
              <a href={service.href} class="service-link">{service.link}</a>
              <span class="service-watermark">SRE</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="method-section section" id="methode">
      <div class="container method-grid">
        <div class="method-intro" data-reveal>
          <div class="eyebrow eyebrow-light"><span class="eyebrow-line"></span> DE LA TERRE À VOTRE TABLE</div>
          <h2>Une démarche limpide,<br /><em>fondée sur la parole donnée.</em></h2>
          <p>Nous croyons qu’un bon repas s’enracine dans la clarté des échanges. De votre demande à l’arrivée du panier, chaque geste est guidé par le respect de votre confiance et la fraîcheur des récoltes.</p>
          <a class="button button-light" href="#contact">Présenter votre besoin</a>
        </div>
        <div class="steps-list">
          {steps.map((step, index) => (
            <div class="step-row" data-reveal data-delay={index * 75}>
              <span class="step-number">{step.n}</span>
              <div class="step-content">
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="method-decoration" aria-hidden="true">SRE</div>
    </section>

    <section class="partner-section section" id="partenaires">
      <div class="container partner-grid">
        <div class="partner-visual" data-reveal>
          <img
            src="/images/biyem-assi-market.jpg"
            width="1400"
            height="804"
            alt="Marché vivrier de Biyem-Assi à Yaoundé, carrefour d'échanges des récoltes du Cameroun"
            loading="lazy"
          />
          <div class="partner-photo-label">
            <span>TERRAIN & RACINES LOCALES</span>
            <strong>Connaître chaque filière,<br />respecter chaque saison.</strong>
          </div>
        </div>
        <div class="partner-copy" data-reveal data-delay="100">
          <div class="eyebrow"><span class="eyebrow-line"></span> ONG · INSTITUTIONS · ACHETEURS</div>
          <h2>Le cœur battant du marché local, <em>la rigueur d’un partenaire d’action.</em></h2>
          <p class="section-lead">Du marché de Biyem-Assi aux carrefours vivriers de Nkomkana et Mokolo, nous sommes au contact direct des réalités agricoles du Cameroun.</p>
          <p>Nous connaissons le rythme des saisons, les fluctuations des récoltes et la juste valeur du travail de la terre. Cette immersion permanente permet à SRE d’offrir aux institutions, organisations humanitaires et programmes de développement un appui logistique transparent, fiable et protecteur des producteurs locaux.</p>
          <div class="partner-points">
            <div>
              <span class="partner-point-icon">01</span>
              <p><strong>Cahier des charges sur-mesure</strong><small>Définition des produits vivriers, volumes requis, calendrier de livraison et critères de qualité.</small></p>
            </div>
            <div>
              <span class="partner-point-icon">02</span>
              <p><strong>Consolidation et préparation</strong><small>Mobilisation des filières locales, pesée rigoureuse, tri soigné et conditionnement protecteur.</small></p>
            </div>
            <div>
              <span class="partner-point-icon">03</span>
              <p><strong>Coordination et suivi</strong><small>Traçabilité des opérations, ponctualité logistique et échanges transparents à chaque étape.</small></p>
            </div>
          </div>
          <p class="partner-note">Chaque partenariat est étudié avec soin selon les capacités mobilisables. Les obligations réglementaires et les pièces administratives spécifiques sont traitées en étroite concertation avec les partenaires habilités.</p>
          <a class="button button-primary" href="#contact" data-contact-topic="Partenariat ONG / institution">Présenter un besoin de partenariat</a>
        </div>
      </div>
    </section>

    <section class="manifesto-band">
      <div class="container manifesto-inner">
        <p>La terre nourrit avec générosité ceux qui la respectent.<br /><em>SRE apporte cette fraîcheur jusqu’au seuil de votre cuisine.</em></p>
        <span class="manifesto-sign">{siteConfig.legalName} — DU CHAMP À VOTRE CUISINE</span>
      </div>
    </section>

    <section class="faq-section section">
      <div class="container faq-grid">
        <div data-reveal>
          <div class="eyebrow"><span class="eyebrow-line"></span> QUESTIONS FRÉQUENTES</div>
          <h2>Des réponses simples<br /><em>pour votre tranquillité.</em></h2>
          <p class="section-lead">Une interrogation sur nos zones de livraison à Yaoundé, nos sélections du terroir ou la gestion de votre budget ? Voici les repères essentiels.</p>
          <a href="#contact" class="underlined-link">Une question particulière ? Écrivez-nous</a>
        </div>
        <div class="faq-list" data-reveal data-delay="100">
          {faqs.map((faq, index) => (
            <details class="faq-item" open={index === 0}>
              <summary><span>{faq.q}</span><i aria-hidden="true"></i></summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="contact-section section" id="contact">
      <div class="container contact-grid">
        <div class="contact-copy" data-reveal>
          <div class="eyebrow eyebrow-light"><span class="eyebrow-line"></span> CONTACTEZ L’ÉQUIPE SRE</div>
          <h2>Confiez-nous<br />vos <em>envies de marché.</em></h2>
          <p class="contact-lead">Une liste de courses pour le foyer, un approvisionnement régulier pour vos fourneaux ou une opération d’envergure ? Présentez-nous votre besoin, nous prenons le temps de vous écouter pour vous apporter la réponse la plus juste et adaptée à votre budget.</p>

          <div class="contact-details">
            <div>
              <span class="contact-detail-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </span>
              <p>
                <small>TÉLÉPHONE & WHATSAPP</small>
                <span>
                  <strong data-config-phone>
                    <a href={`tel:${siteConfig.phone.replace(/\s/g, '')}`}>{siteConfig.phone}</a>
                    {' · '}
                    <a href={`tel:${siteConfig.secondaryPhone.replace(/\s/g, '')}`}>{siteConfig.secondaryPhone}</a>
                  </strong>
                  {siteConfig.whatsapp && (
                    <a
                      href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent('Bonjour SRE, je souhaite échanger sur un approvisionnement en vivres frais.')}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="contact-whatsapp-tag"
                      aria-label="Échanger directement avec SRE sur WhatsApp"
                    >
                      <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M20.3 11.7a8.3 8.3 0 0 1-12.2 7.4L3 20l.9-4.8a8.3 8.3 0 1 1 16.4-3.5Z"/>
                        <path d="M8.6 8.2c.2-.5.5-.5.8-.5h.4c.2 0 .3.1.4.4l.6 1.4c.1.2.1.4 0 .5l-.4.6c-.1.2-.2.3 0 .5.2.4.8 1.1 1.6 1.6.9.6 1.2.5 1.5.3l.6-.7c.2-.2.3-.2.6-.1l1.3.6c.3.1.4.2.4.4 0 .2-.1 1-.7 1.4-.5.4-1.1.6-1.8.4-.7-.2-1.5-.5-2.6-1.3-1.3-1-2.2-2.3-2.4-2.7-.3-.4-.6-1.2-.3-1.8Z"/>
                      </svg>
                      <span>WhatsApp direct</span>
                    </a>
                  )}
                </span>
              </p>
            </div>

            <div>
              <span class="contact-detail-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </span>
              <p>
                <small>COURRIER ÉLECTRONIQUE</small>
                <strong data-config-email><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></strong>
              </p>
            </div>

            <div>
              <span class="contact-detail-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </span>
              <p>
                <small>SIÈGE D'ACTIVITÉ</small>
                <strong>{siteConfig.location}</strong>
              </p>
            </div>

            <div>
              <span class="contact-detail-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
              </span>
              <p>
                <small>RÉFÉRENCES COMMERCIALES</small>
                <strong>RCCM : {siteConfig.rccm} &nbsp;·&nbsp; NIU : {siteConfig.niu}</strong>
              </p>
            </div>
          </div>
        </div>

        <form class="contact-form" id="contact-form" data-reveal data-delay="120">
          <div class="form-heading">
            <span>VOTRE DEMANDE D’APPROVISIONNEMENT</span>
          </div>
          <div class="form-row">
            <label>Votre nom complet
              <input name="name" type="text" placeholder="Ex. Marie Talla" autocomplete="name" required />
            </label>
            <label>Votre organisation ou foyer
              <input name="organisation" type="text" placeholder="Foyer, Restaurant, Entreprise, ONG…" autocomplete="organization" />
            </label>
          </div>
          <div class="form-row">
            <label>Votre adresse e-mail
              <input name="email" type="email" placeholder="votre.adresse@domaine.com" autocomplete="email" required />
            </label>
            <label>Votre téléphone (WhatsApp de préférence)
              <input name="phone" type="tel" placeholder="+237 6..." autocomplete="tel" />
            </label>
          </div>
          <label>Nature de votre besoin
            <select name="topic" id="contact-topic" required>
              <option value="" disabled selected>Précisez votre demande</option>
              <option>Panier de courses pour un foyer</option>
              <option>Approvisionnement pour restaurant ou traiteur</option>
              <option>Partenariat institutionnel ou programme ONG</option>
              <option>Commande volumineuse ou denrée spécifique</option>
              <option>Autre demande d’information</option>
            </select>
          </label>
          <label>Votre message ou liste de vivres
            <textarea name="message" rows="4" placeholder="Indiquez les vivres recherchés, les quantités estimées, votre quartier à Yaoundé ou toute précision utile…" required></textarea>
          </label>
          <div class="form-footer">
            <p>Vos coordonnées sont traitées avec soin et servent exclusivement à vous répondre.</p>
            <button class="button button-primary" type="submit">Transmettre ma demande</button>
          </div>
          <p class="form-feedback" id="form-feedback" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-main">
      <a class="brand brand-footer" href="#top" aria-label="SRE — Retour au sommet">
        <span class="brand-mark"><span>S</span><span>R</span><span>E</span></span>
        <span class="brand-copy"><strong>{siteConfig.name}</strong><small>{siteConfig.legalName}</small></span>
      </a>
      <p>{siteConfig.fullTagline}<br /><em>La confiance à chaque livraison.</em></p>
      <a class="footer-top" href="#top" aria-label="Retourner en haut de la page">RETOUR EN HAUT <span>↑</span></a>
    </div>

    {hasSocial && (
      <div class="container footer-social">
        <span class="footer-social-label">Suivez SRE :</span>
        <div class="social-links">
          {siteConfig.social.facebook && (
            <a
              href={siteConfig.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="social-link"
              aria-label="Rejoindre SRE sur Facebook"
            >
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              <span>Facebook</span>
            </a>
          )}
          {siteConfig.social.instagram && (
            <a
              href={siteConfig.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="social-link"
              aria-label="Suivre SRE sur Instagram"
            >
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
              </svg>
              <span>Instagram</span>
            </a>
          )}
          {siteConfig.social.linkedin && (
            <a
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="social-link"
              aria-label="Suivre SRE sur LinkedIn"
            >
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64a1.64 1.64 0 1 0 1.64 1.64 1.64 1.64 0 0 0-1.64-1.64z"/>
              </svg>
              <span>LinkedIn</span>
            </a>
          )}
        </div>
      </div>
    )}

    <div class="container footer-meta">
      <div class="footer-legal-info">
        <span><strong>Siège :</strong> {siteConfig.location}</span>
        <span class="footer-sep" aria-hidden="true">·</span>
        <span><strong>RCCM :</strong> {siteConfig.rccm}</span>
        <span class="footer-sep" aria-hidden="true">·</span>
        <span><strong>NIU :</strong> {siteConfig.niu}</span>
      </div>
      <div class="footer-contact-links">
        <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href={`tel:${siteConfig.phone.replace(/\s/g, '')}`}>{siteConfig.phone}</a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href={`tel:${siteConfig.secondaryPhone.replace(/\s/g, '')}`}>{siteConfig.secondaryPhone}</a>
      </div>
    </div>

    <div class="container footer-bottom">
      <span>© {new Date().getFullYear()} {siteConfig.name} — {siteConfig.legalName}. Tous droits réservés.</span>
      {siteConfig.developer.name && (
        <span class="footer-dev">
          Conception & Développement :{' '}
          {siteConfig.developer.url ? (
            <a href={siteConfig.developer.url} target="_blank" rel="noopener noreferrer">
              <strong>{siteConfig.developer.name}</strong> ↗
            </a>
          ) : (
            <strong>{siteConfig.developer.name}</strong>
          )}
        </span>
      )}
      <a href="#contact">Nous contacter</a>
    </div>
  </footer>
</BaseLayout>
