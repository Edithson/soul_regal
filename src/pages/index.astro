---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const services = [
  {
    number: '01',
    icon: 'basket',
    title: 'Pour les ménages',
    description: 'Vos courses agricoles, sans les contraintes. Du champ à votre cuisine, nous sélectionnons fruits, légumes, tubercules, céréales et épices selon vos préférences et votre budget.',
    points: ['Listes de courses personnalisées', 'Sélection selon vos préférences', 'Livraison soignée à domicile'],
    link: 'Parler de mes courses',
    href: '#contact',
    tone: 'sage',
  },
  {
    number: '02',
    icon: 'store',
    title: 'Pour les professionnels',
    description: 'Restaurants, hôtels, commerces et entreprises : un approvisionnement pensé autour de vos produits, de vos volumes et de votre rythme.',
    points: ['Commandes ponctuelles ou récurrentes', 'Paniers adaptés à votre activité', 'Coordination des livraisons'],
    link: 'Construire mon approvisionnement',
    href: '#contact',
    tone: 'cream',
  },
  {
    number: '03',
    icon: 'globe',
    title: 'Pour les ONG & partenaires',
    description: 'Un relais d’approvisionnement local pour mobiliser les fournisseurs, consolider les produits agricoles et préparer les commandes liées à vos programmes ou opérations d’exportation.',
    points: ['Sourcing et regroupement des produits', 'Tri et conditionnement selon le besoin', 'Coordination avec les partenaires logistiques'],
    link: 'Échanger sur un partenariat',
    href: '#partenaires',
    tone: 'sand',
  },
];

const steps = [
  { n: '01', title: 'Nous écoutons', text: 'Vos besoins, vos quantités, vos préférences, vos contraintes et vos délais.' },
  { n: '02', title: 'Nous approvisionnons', text: 'Nous recherchons les produits auprès de circuits et producteurs adaptés selon votre budget.' },
  { n: '03', title: 'Nous préparons', text: 'Les produits sont sélectionnés, triés et préparés selon la commande convenue.' },
  { n: '04', title: 'Nous livrons', text: 'La livraison est coordonnée avec vous, avec un suivi adapté à votre planning.' },
];

const faqs = [
  { q: 'Dans quelles zones SRE intervient-elle ?', a: 'Notre siège d’activité est situé à Nkomkana, Yaoundé. Nous organisons les collectes et livraisons sur Yaoundé et étudions les demandes pour d’autres zones selon les volumes et les contraintes logistiques.' },
  { q: 'Peut-on commander des produits précis ou une liste complète de courses ?', a: 'Oui. Les demandes peuvent porter sur un produit spécifique, une sélection de saison ou une liste complète de courses (fruits, légumes, tubercules, céréales, légumineuses, épices).' },
  { q: 'Comment SRE s’adapte-t-elle à mon budget ?', a: 'Pour chaque commande ou projet, nous échangeons avec vous sur vos volumes et votre enveloppe budgétaire afin de proposer les filières d’approvisionnement et calibres les plus adaptés.' },
  { q: 'Comment vous contacter rapidement ?', a: 'Vous pouvez nous joindre par téléphone ou WhatsApp au +237 683 511 935 ou +237 694 929 167, ou par e-mail à sre.cameroun@gmail.com.' },
  { q: 'SRE travaille-t-elle avec les ONG et les organisations internationales ?', a: 'Oui. SRE accompagne les programmes d’ONG et les acheteurs institutionnels pour le sourcing local, le regroupement et la préparation de denrées agricoles.' },
];
---

<BaseLayout>
  <div class="announcement-bar">
    <div class="container announcement-inner">
      <span class="announcement-dot"></span>
      <span>{siteConfig.fullTagline} · Produits agricoles & alimentaires</span>
      <span class="announcement-location">{siteConfig.location}</span>
    </div>
  </div>

  <header class="site-header" id="top">
    <div class="container nav-wrap">
      <a class="brand" href="#top" aria-label="SRE — Accueil">
        <span class="brand-mark"><span>S</span><span>R</span><span>E</span></span>
        <span class="brand-copy"><strong>{siteConfig.name}</strong><small>{siteConfig.legalName}</small></span>
      </a>
      <button class="menu-toggle" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="main-nav">
        <span></span><span></span>
      </button>
      <nav class="main-nav" id="main-nav" aria-label="Navigation principale">
        <a href="#maison">Notre maison</a>
        <a href="#solutions">Nos solutions</a>
        <a href="#methode">Notre méthode</a>
        <a href="#partenaires">Partenaires</a>
        <a class="nav-cta" href="#contact">Parlons de votre besoin <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero section-shell">
      <div class="hero-glow"></div>
      <div class="container hero-grid">
        <div class="hero-copy" data-reveal>
          <div class="eyebrow"><span class="eyebrow-line"></span> {siteConfig.fullTagline}</div>
          <h1>Le meilleur du<br />terroir, <em>à votre</em><br /><em>porte.</em></h1>
          <p class="hero-lead">{siteConfig.mission}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#solutions">Découvrir nos solutions <span class="button-arrow">↗</span></a>
            <a class="text-link" href="#maison">Découvrir SRE <span>↓</span></a>
          </div>
          <div class="hero-proof">
            <div class="proof-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5C10 3.5 4 7.3 4 14.2c0 3.2 2.3 5.3 5.4 5.3 7.2 0 11.1-7.2 11.1-16Z"/><path d="M3.5 21c2.6-5.2 6.3-8.6 11.2-10.7"/></svg></div>
            <p><strong>Du champ à votre cuisine.</strong><span>La proximité comme point de départ. L’accompagnement selon votre budget.</span></p>
          </div>
        </div>

        <div class="hero-visual" data-reveal data-delay="140">
          <div class="hero-image-main">
            <img src="/images/hero-produce.jpg" alt="Sélection de légumes frais et colorés sur un étal" fetchpriority="high" />
          </div>
          <div class="hero-image-stamp"><span>DU CHAMP</span><strong>À VOTRE<br />CUISINE.</strong><i>✳</i></div>
          <div class="hero-floating-card">
            <span class="floating-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7.5h16l-1.4 12H5.4L4 7.5Z"/><path d="M8 8V6a4 4 0 0 1 8 0v2"/><path d="m9 13 2 2 4-4"/></svg></span>
            <span><strong>Du choix à la livraison</strong><small>Selon votre budget</small></span>
          </div>
          <span class="hero-vertical-note">SÉLECTION · ACCOMPAGNEMENT · LIVRAISON</span>
        </div>
      </div>
      <div class="container hero-bottomline">
        <span>01 — UNE AUTRE IDÉE DE L’APPROVISIONNEMENT</span>
        <span class="scroll-cue"><span></span> FAITES DÉFILER</span>
        <span>YAOUNDÉ · DU CHAMP À VOTRE CUISINE</span>
      </div>
    </section>

    <section class="intro-strip" aria-label="Les engagements SRE">
      <div class="container intro-strip-grid">
        <p class="strip-lead">Le bon produit.<br /><em>Le bon moment.</em></p>
        <div class="strip-item"><span class="strip-number">01</span><div><strong>Proximité</strong><small>Valoriser les circuits locaux.</small></div></div>
        <div class="strip-item"><span class="strip-number">02</span><div><strong>Exigence</strong><small>Prendre soin de chaque commande.</small></div></div>
        <div class="strip-item"><span class="strip-number">03</span><div><strong>Adaptabilité</strong><small>Accompagnement selon votre budget.</small></div></div>
      </div>
    </section>

    <section class="product-band" aria-label="Familles de produits approvisionnés">
      <div class="container product-band-inner">
        <span class="product-band-label">AU FIL DES SAISONS, SELON DISPONIBILITÉ</span>
        <div class="product-tags">
          <span>Fruits & légumes frais</span>
          <i>✳</i>
          <span>Tubercules & racines</span>
          <i>✳</i>
          <span>Céréales & légumineuses</span>
          <i>✳</i>
          <span>Épices & aromates</span>
        </div>
      </div>
    </section>

    <section class="section about-section" id="maison">
      <div class="container about-grid">
        <div class="about-visual" data-reveal>
          <div class="about-image-large"><img src="/images/paysage2.jpg" alt="Paysage agricole verdoyant au lever du jour" loading="lazy" /></div>
          <div class="about-image-small"><img src="/images/about-vegetables.jpg" alt="Assortiment frais de légumes et de feuilles vertes" loading="lazy" /></div>
          <div class="about-caption"><span>LA TERRE NOUS RASSEMBLE</span><strong>Du vivant<br />au quotidien.</strong></div>
        </div>
        <div class="about-copy" data-reveal data-delay="100">
          <div class="eyebrow"><span class="eyebrow-line"></span> QUI NOUS SOMMES</div>
          <h2>Une entreprise de proximité, <em>une exigence sans égal.</em></h2>
          <p class="section-lead">{siteConfig.legalName} ({siteConfig.name}) est née d’une conviction claire : bien s’approvisionner en produits agricoles et alimentaires ne devrait être ni compliqué, ni approximatif.</p>
          <p>Implantée à {siteConfig.location}, SRE rapproche les produits du terroir de celles et ceux qui en ont besoin. Du champ à votre cuisine, nous sélectionnons, trions et préparons vos commandes avec rigueur et transparence.</p>
          <p>Pour un foyer, cela se traduit par des courses personnalisées livrées avec soin. Pour les professionnels, un approvisionnement régulier et fiable. Pour les partenaires et ONG, une capacité d'accompagnement et de coordination logistique éprouvée, toujours en accord avec votre budget.</p>
          <a class="underlined-link" href="#methode">Comprendre notre approche <span>↗</span></a>
          <div class="signature"><span class="signature-mark">SRE</span><span><strong>{siteConfig.legalName}</strong><small>{siteConfig.fullTagline}</small></span></div>
        </div>
      </div>
    </section>

    <section class="section solutions-section" id="solutions">
      <div class="container">
        <div class="section-heading section-heading-row" data-reveal>
          <div>
            <div class="eyebrow"><span class="eyebrow-line"></span> CE QUE NOUS FAISONS</div>
            <h2>Une même exigence.<br /><em>Trois façons de vous servir.</em></h2>
          </div>
          <p>Les besoins changent. Notre écoute et notre capacité d’adaptation restent au cœur de chaque collaboration.</p>
        </div>
        <div class="services-grid">
          {services.map((service) => (
            <article class={`service-card service-${service.tone}`} data-reveal>
              <div class="service-topline"><span>{service.number} / 03</span><span class="service-icon" aria-hidden="true">
                {service.icon === 'basket' && <svg viewBox="0 0 24 24"><path d="m3 9 2 11h14l2-11H3Z"/><path d="M7 9 12 3l5 6M8.5 12l.8 5M15.5 12l-.8 5M12 12v5"/></svg>}
                {service.icon === 'store' && <svg viewBox="0 0 24 24"><path d="M3 10h18l-1.5-6h-15L3 10Z"/><path d="M5 10v10h14V10M9 20v-6h6v6M3 10a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0"/></svg>}
                {service.icon === 'globe' && <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg>}
              </span></div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <ul>{service.points.map((point) => <li><span>↗</span>{point}</li>)}</ul>
              <a href={service.href} class="service-link">{service.link}<span>↗</span></a>
              <span class="service-watermark">SRE</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="method-section section" id="methode">
      <div class="container method-grid">
        <div class="method-intro" data-reveal>
          <div class="eyebrow eyebrow-light"><span class="eyebrow-line"></span> DE LA DEMANDE À LA LIVRAISON</div>
          <h2>Une méthode claire.<br /><em>Un engagement concret.</em></h2>
          <p>Nous croyons qu’un bon service commence par une bonne compréhension du besoin. Chaque commande mérite une organisation adaptée, des échanges simples et des engagements réalistes selon votre budget.</p>
          <a class="button button-light" href="#contact">Parlons de votre projet <span class="button-arrow">↗</span></a>
        </div>
        <div class="steps-list">
          {steps.map((step, index) => (
            <div class="step-row" data-reveal data-delay={index * 75}>
              <span class="step-number">{step.n}</span>
              <div class="step-content"><h3>{step.title}</h3><p>{step.text}</p></div>
              <span class="step-arrow">↗</span>
            </div>
          ))}
        </div>
      </div>
      <div class="method-decoration" aria-hidden="true">SRE</div>
    </section>

    <section class="partner-section section" id="partenaires">
      <div class="container partner-grid">
        <div class="partner-visual" data-reveal>
          <img src="/images/biyem-assi-market.jpg" alt="marché de biyem-assi - Yaoundé" loading="lazy" />
          <div class="partner-photo-label"><span>PARTENARIATS & IMPACT LOCAL</span><strong>Faire équipe,<br />pour aller plus loin.</strong></div>
        </div>
        <div class="partner-copy" data-reveal data-delay="100">
          <div class="eyebrow"><span class="eyebrow-line"></span> ONG · INSTITUTIONS · ACHETEURS</div>
          <h2>Vos missions méritent un partenaire <em>qui connaît le terrain.</em></h2>
          <p class="section-lead">Vous préparez un programme, une opération d’achat ou une chaîne d’approvisionnement agricole ? SRE met son activité au service des programmes d’ONG et des opérations d'approvisionnement, en lien avec les acteurs locaux.</p>
          <div class="partner-points">
            <div><span class="partner-point-icon">01</span><p><strong>Comprendre votre cahier des charges</strong><small>Produits, quantités, budget, calendrier et critères attendus.</small></p></div>
            <div><span class="partner-point-icon">02</span><p><strong>Construire une réponse adaptée</strong><small>Identification des filières, consolidation des besoins et préparation des commandes.</small></p></div>
            <div><span class="partner-point-icon">03</span><p><strong>Coordonner les opérations</strong><small>Livraison, conditionnement et suivi avec les partenaires logistiques.</small></p></div>
          </div>
          <p class="partner-note">Chaque partenariat est étudié selon les capacités mobilisables et les exigences du projet. Les exigences réglementaires, les documents et les responsabilités liés à l’exportation sont à valider avec les partenaires habilités.</p>
          <a class="button button-primary" href="#contact" data-contact-topic="Partenariat ONG / institution">Présenter un projet à SRE <span class="button-arrow">↗</span></a>
        </div>
      </div>
    </section>

    <section class="manifesto-band">
      <div class="container manifesto-inner">
        <span class="manifesto-star">✳</span>
        <p>Du champ à votre cuisine.<br /><em>L'approvisionnement agricole adapté à votre budget.</em></p>
        <span class="manifesto-sign">{siteConfig.legalName} — {siteConfig.name}</span>
      </div>
    </section>

    <section class="faq-section section">
      <div class="container faq-grid">
        <div data-reveal>
          <div class="eyebrow"><span class="eyebrow-line"></span> VOUS SOUHAITEZ EN SAVOIR PLUS ?</div>
          <h2>Les bonnes réponses<br /><em>commencent ici.</em></h2>
          <p class="section-lead">Une question sur nos services ou sur la faisabilité d’un approvisionnement ? Voici quelques premiers repères.</p>
          <a href="#contact" class="underlined-link">Une autre question ? Écrivez-nous <span>↗</span></a>
        </div>
        <div class="faq-list" data-reveal data-delay="100">
          {faqs.map((faq, index) => (
            <details class="faq-item" open={index === 0}>
              <summary><span>{faq.q}</span><i aria-hidden="true"></i></summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="contact-section section" id="contact">
      <div class="container contact-grid">
        <div class="contact-copy" data-reveal>
          <div class="eyebrow eyebrow-light"><span class="eyebrow-line"></span> DONNONS VIE À VOTRE BESOIN</div>
          <h2>Parlons de ce<br />qui vous <em>nourrit.</em></h2>
          <p>Pour vos besoins en produits agricoles et alimentaires, SRE vous accompagne dans la recherche et l'approvisionnement selon votre budget.</p>
          <div class="contact-details">
            <div>
              <span class="contact-detail-icon">✳</span>
              <p>
                <small>NOUS ÉCRIRE</small>
                <strong data-config-email><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></strong>
              </p>
            </div>
            <div>
              <span class="contact-detail-icon">↗</span>
              <p>
                <small>TÉLÉPHONE / WHATSAPP</small>
                <strong data-config-phone>
                  <a href={`tel:${siteConfig.phone.replace(/\s/g, '')}`}>{siteConfig.phone}</a>
                  {' / '}
                  <a href={`tel:${siteConfig.secondaryPhone.replace(/\s/g, '')}`}>{siteConfig.secondaryPhone}</a>
                </strong>
              </p>
            </div>
            <div>
              <span class="contact-detail-icon">⌖</span>
              <p>
                <small>SIÈGE D'ACTIVITÉ</small>
                <strong>{siteConfig.location}</strong>
              </p>
            </div>
            <div>
              <span class="contact-detail-icon">⚖</span>
              <p>
                <small>INFORMATIONS LÉGALES</small>
                <strong>RCCM : {siteConfig.rccm} &nbsp;·&nbsp; NIU : {siteConfig.niu}</strong>
              </p>
            </div>
          </div>
        </div>
        <form class="contact-form" id="contact-form" data-reveal data-delay="120">
          <div class="form-heading"><span>VOTRE DEMANDE</span><span class="form-index">SRE / 01</span></div>
          <div class="form-row">
            <label>Votre nom<input name="name" type="text" placeholder="Nom et prénom" autocomplete="name" required /></label>
            <label>Votre organisation<input name="organisation" type="text" placeholder="Entreprise, ONG… (facultatif)" autocomplete="organization" /></label>
          </div>
          <div class="form-row">
            <label>Votre adresse e-mail<input name="email" type="email" placeholder="vous@exemple.com" autocomplete="email" required /></label>
            <label>Votre téléphone<input name="phone" type="tel" placeholder="+237 …" autocomplete="tel" /></label>
          </div>
          <label>Votre besoin
            <select name="topic" id="contact-topic" required>
              <option value="" disabled selected>Choisissez le sujet de votre demande</option>
              <option>Courses pour un ménage</option>
              <option>Approvisionnement professionnel</option>
              <option>Partenariat ONG / institution</option>
              <option>Exportation / coordination logistique</option>
              <option>Autre demande</option>
            </select>
          </label>
          <label>Votre message<textarea name="message" rows="4" placeholder="Quelques mots sur les produits, quantités, délais ou zones concernées…" required></textarea></label>
          <div class="form-footer">
            <p>Vos informations servent uniquement à traiter votre demande.</p>
            <button class="button button-primary" type="submit">Envoyer ma demande <span class="button-arrow">↗</span></button>
          </div>
          <p class="form-feedback" id="form-feedback" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-main">
      <a class="brand brand-footer" href="#top" aria-label="SRE — Retour en haut">
        <span class="brand-mark"><span>S</span><span>R</span><span>E</span></span>
        <span class="brand-copy"><strong>{siteConfig.name}</strong><small>{siteConfig.legalName}</small></span>
      </a>
      <p>{siteConfig.fullTagline}<br /><em>La confiance à chaque livraison.</em></p>
      <a class="footer-top" href="#top">RETOUR EN HAUT <span>↑</span></a>
    </div>
    <div class="container footer-meta">
      <div class="footer-legal-info">
        <span><strong>Siège :</strong> {siteConfig.location}</span>
        <span class="footer-sep" aria-hidden="true">·</span>
        <span><strong>RCCM :</strong> {siteConfig.rccm}</span>
        <span class="footer-sep" aria-hidden="true">·</span>
        <span><strong>NIU :</strong> {siteConfig.niu}</span>
      </div>
      <div class="footer-contact-links">
        <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href={`tel:${siteConfig.phone.replace(/\s/g, '')}`}>{siteConfig.phone}</a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href={`tel:${siteConfig.secondaryPhone.replace(/\s/g, '')}`}>{siteConfig.secondaryPhone}</a>
      </div>
    </div>
    <div class="container footer-bottom">
      <span>© {new Date().getFullYear()} {siteConfig.name} — {siteConfig.legalName}. Tous droits réservés.</span>
      <span>{siteConfig.tagline}</span>
      <a href="#contact">Nous contacter ↗</a>
    </div>
  </footer>
</BaseLayout>
